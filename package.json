{
  "name": "@usespaceui/avatars",
  "version": "0.1.4",
  "description": "A dynamic, code-driven SVG avatar generator for React applications.",
  "author": {
    "name": "SpaceUI",
    "email": "hello@spaceui.one",
    "url": "https://www.spaceui.one"
  },
  "contributors": [
    {
      "name": "SpaceUI Team",
      "email": "hello@spaceui.one",
      "url": "https://www.spaceui.one"
    }
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/usespaceui"
  },
  "license": "MIT",
  "homepage": "https://avatars.spaceui.one",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usespaceui/avatars.git"
  },
  "bugs": {
    "url": "https://github.com/usespaceui/avatars/issues",
    "email": "hello@spaceui.one"
  },
  "keywords": [
    "avatars",
    "svg",
    "procedural",
    "generative",
    "spaceui",
    "react",
    "vue",
    "solid",
    "svelte",
    "deterministic"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node test/contracts.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@usespaceui/gradients": "^0.1.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
